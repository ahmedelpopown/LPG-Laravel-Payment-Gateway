{
    "name": "ahmedelpopown/lpg-laravel-payment-gateway",
    "description": "Reusable Laravel Payment Core for Stripe, PayPal, refunds, webhooks and reconciliation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "php": "^8.3",
        "stripe/stripe-php": "^23.0"
    },
    "autoload": {
        "psr-4": {
            "Ahmed\\LaravelPayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahmed\\LaravelPayment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahmed\\LaravelPayment\\Providers\\LaravelPaymentServiceProvider",
                "Ahmed\\LaravelPayment\\Reconciliation\\Providers\\ReconciliationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest tests/Unit",
        "test:feature": "pest tests/Feature"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
